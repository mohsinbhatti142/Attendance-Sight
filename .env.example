# Application
APP_NAME=Attendance-Sight
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
LOCAL_DEMO_MODE=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/attendance.db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Face Recognition
FACE_DETECTION_MODEL=retinaface_r50
FACE_RECOGNITION_MODEL=arcface_r100
FACE_DETECTION_THRESHOLD=0.5
FACE_RECOGNITION_THRESHOLD=0.6
FACE_QUALITY_MIN_SIZE=80
MAX_FACES_PER_FRAME=10

# Camera
FRAME_SKIP=3
CAMERA_RESOLUTION_WIDTH=1280
CAMERA_RESOLUTION_HEIGHT=720

# Storage
FACE_IMAGES_DIR=data/face_images
MODEL_WEIGHTS_DIR=data/models
FAISS_INDEX_DIR=data/faiss_index

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
